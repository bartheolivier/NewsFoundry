# Base de Données PostgreSQL
DATABASE_URL='postgresql://user:password@localhost:5432/newsfoundry'

# Sécurité JWT & Compte d'accès initial (personnaliser impérativement en production)
SECRET_KEY='change-me-with-openssl-rand-hex-32'
DEMO_USER_EMAIL='test@test.com'
DEMO_USER_PASSWORD='test'

# Protection CORS & Maîtrise de la facturation API (FinOps)
CORS_ORIGINS='*'
MAX_LOGIN_ATTEMPTS=8
MAX_DAILY_AI_CALLS=100

# Clés API IA & Actualités
GEMINI_API_KEY=''
LLM_MODEL='gemini-3.5-flash-lite'
WORLD_NEWS_API_KEY=''
